# Operating-system files
.DS_Store
Thumbs.db
desktop.ini

# Editor settings
.idea/
.vscode/

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Story OS / Codex transient runtime homes and helper scripts
.tmp-codex-critic-home/
_tmp_*
episodes/_system/_tmp_*
# Detached-driver contract tests use tempfile under episodes/_tests; Windows child
# processes can briefly outlive cleanup and leave these smoke directories behind.
episodes/_tests/driver-*/
episodes/_tests/p4-production-canary-*/
episodes/_tests/tmp*/
# Some tests use Path("ep") as a repository-root scratch Episode; never version its outputs.
/ep/

# 归档豁免：.storyos/archive/ 下是有据可查的正式归档资产（带 README、走 git mv、
# 逐文件 SHA-256 校验），不受上面 _tmp_* 等全局临时规则约束。
# 注意：本行必须排在 _tmp_* 之后，并排在下方 v2-runtime backups/smoke 忽略规则之前。
!/.storyos/archive/**

# Story OS high-volume raw runtime logs are local/derived evidence.
# Formal review JSON and SHA-bound critic evidence remain trackable.
episodes/**/meta/**/*.jsonl
episodes/**/meta/image-workers/
episodes/**/meta/rolling-review-workers/
episodes/**/meta/scoped-workers/
episodes/**/meta/runtime/driver-logs/
episodes/**/meta/runtime/preimage-candidates/
episodes/**/meta/runtime/batch-reviews/
episodes/**/meta/runtime/diagnostics/
# Keep Git ignore policy aligned with runtime_log_policy.LOCAL_ONLY_PATTERNS.
episodes/**/meta/episode-performance-ledger.json
episodes/**/meta/runtime-runner.lock
episodes/**/meta/runtime-image-scheduler.lock

# Python build artifacts
__pycache__/
*.pyc

# Web console / Node build artifacts
web-console/node_modules/
# Local Web Console migration/runtime artifacts; never commit generated dev logs,
# alternate lockfiles, or copied pixel previews outside the episode media policy.
npm-dev.*
web-console/npm-dev.*
web-console/bun.lock
web-console/public/assets/characters/female-lead/

# Codex tool output
.codex/
.playwright-cli/
.codex-review/

# Story OS local install / backup / migration state
.story-os-v*installed.json
.story-upgrade-backups/
.story-os-upgrade-backups/
.story-os-backups/
.story-os-*-backups/
.story-os-history/
.story-os-media-migration/
.story-os-media-inventory.json
.storyos_backups/

# Episode meta intermediate review candidates (formal evidence lives in final files)
episodes/**/meta/.*.candidate.json

# Local opt-out marker for reference/image sets that live under episodes/ but are not Episodes.
# Canonical discovery still requires meta/episode-state.json and excludes _system/_tests.
episodes/**/.storyos-non-episode.json

# Story OS local virtualenv / upgrade packages
.story-os-venv/
Story_OS_V2.0_OneClick_FullAuto_Upgrade_UTF8_FINAL/
DaliCat_StoryOS_*/
Story_OS_V2.0.2_Production_Closure_OneClick_Upgrade_UTF8_FINAL/
DaliCat_StoryOS_V2.0.3.2_CreativeEnforcement_RootSafe_R3/
Story_OS_V2.1_*/
storyos_*/
StoryOS_*_Hotfix.py

# Local workbench
workbench/tmp/

# Episode media policy:
# all image/video/audio/archive binaries below episodes/ remain LOCAL ONLY,
# EXCEPT series master images（系列剧本母版图）: every path referenced by
# episodes/**/meta/series-character-identity.json MUST be committed to Git.
# Git tracks story/meta/code; other pixel assets are linked by SHA/media-index.
episodes/**/media/
episodes/**/*.png
episodes/**/*.jpg
episodes/**/*.jpeg
episodes/**/*.gif
episodes/**/*.webp
episodes/**/*.bmp
episodes/**/*.ico
episodes/**/*.tif
episodes/**/*.tiff
episodes/**/*.svg
episodes/**/*.mp4
episodes/**/*.mov
episodes/**/*.avi
episodes/**/*.mkv
episodes/**/*.wav
episodes/**/*.mp3
episodes/**/*.flac
episodes/**/*.zip

# Series master images / character anchors: REQUIRED in Git, not merely allowed.
# Scope and enforcement: AGENTS.md「提交规则」and contract_sync.untracked_series_masters().
!episodes/**/assets/characters/**

# research/competitors/** and research/account/** are intentionally not ignored.

# Story OS R2 runtime cache
.storyos_cache/

# Story OS dot-directory local install evidence
.storyos/backups/
.storyos/history/

# V2 runtime archive（2026-09-11 从 .storyos/backups 与 .storyos/smoke 归档迁移，内容不提交）
.storyos/archive/v2-runtime/backups/
.storyos/archive/v2-runtime/smoke/

# Local scratch only; formal episode evidence remains tracked selectively.
/NUL
/.storyos/smoke/
/.storyos/tmp/
/.storyos/runtime/
/.storyos/drill/
/.storyos/alert-channel/
/.storyos/metrics/
/.storyos/runtime-launcher/
/.storyos/platform-console/
/.storyos/auto-recovery/
# P4/P5 shadow execution raw outputs and one-off production helper inputs are local runtime evidence.
# Formal cutover / acceptance conclusions belong in reports/, not in these workbench paths.
/.storyos/p4-capability-router/production/
/.storyos/production-input/

# .storyos 工作台 / 版面探查产物为本地派生证据，不入库。
# 有意归档物在 .storyos/archive/ 下独立跟踪（见各 archive README）。
# 2026-09-11：这批曾被测图/并发进程误暂存（55 张 PNG 共 54.7MB），故在此硬拦截。
/.storyos/*.log
/.storyos/*.png
/.storyos/layout_final.json
/.storyos/layoutprobe.json
/.storyos/bands/
/.storyos/strip/
/.storyos/under/
/.storyos/zbox/
/.storyos/bandpreview/

# Chromium / crashpad 杂项日志（reports/ 下只保留正式报告）
/reports/debug.log

# Root-level production runtime queue/reconciliation outputs are regenerated locally.
/meta/production-queue.json
/meta/runtime/
/meta/runtime-image-scheduler.lock

# Codex user-mode bridge channel: loopback endpoint, local nonce, shared task
# staging. Local only, never a place for Codex credentials.
# STORY_OS_V2_7_CODEX_USER_MODE_BRIDGE
/runtime/codex-user-runner/

# Compiled Runtime Request staging copies are local handoff artifacts. Once an
# Episode exists, episodes/**/meta/runtime-request.json is the immutable bound
# request/provenance record and remains trackable.
/runtime/requests/

# B5 golden run derived report (regenerated by workflow_dispatch job; registry stays tracked).
/reports/golden-episode-regression.json
# Performance summary is rebuilt automatically from Episode telemetry; keep the generated view local.
/reports/story-os-performance-summary.json

# Local AI coding assistant scratch outputs
# These are generated during Codex/DevSpace execution and are not project assets.
.codex-run/
.codex-write-probe.txt

# Local temporary audit / analysis outputs
.storyos-tmp/
.tmp-audit/
.tmp-caption-audit/
.tmp_crops/

# Local image generation experiments
# Formal episode media remains local under media policy above.
codex-generated-images/

# Local probe scripts generated during debugging
.preimage_author_tmp.py
.probe-tmp.py

# Locally generated Codex/Phase5a experiments and operator-only evidence.
# Do not ignore canonical Episode evidence or formal docs/archive trees.
/.codex_tmp/
/.storyos/opencodex-maintenance/
/.storyos/pre-ff-backup/
/.storyos/native-frame01-recovery-archives/
/.storyos/p4-capability-router/*-shadow-a1-*.json
/.storyos/archive/worktree-retirement-*/
